# Paste your OpenRouter key here. Do not paste keys in chat.
OPENROUTER_API_KEY=
# Create a LINE Official Account, enable Messaging API, then fill these in.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Optional: enable official short-lived token renewal with your own channel ID.
LINE_CHANNEL_ID=
LINE_TOKEN_EXPIRES_AT=
# Send /我的ID to the bot to learn your ID, then fill this and restart.
LINE_OWNER_USER_ID=
LINE_OWNER_NAMES=
# Run python configure_bot.py to fill this from your own bot-info endpoint.
LINE_BOT_USER_ID=
# Generated by setup.py. Shared only between n8n and the local service.
INTERNAL_TOKEN=
N8N_ENCRYPTION_KEY=
# Public HTTPS base address for n8n, ending in /.
WEBHOOK_URL=http://localhost:5678/
ELF_DB=data/elf.sqlite3
ELF_PORT=8787
OBSIDIAN_VAULT=
OPENROUTER_FREE_MODEL=openrouter/free
# Optional shared group-digest trial. Calendar/Obsidian remain owner-only.
PUBLIC_GROUPS_ENABLED=0
PUBLIC_MAX_USERS=50
PUBLIC_USER_DAILY_CALLS=30
PUBLIC_GLOBAL_DAILY_CALLS=900
# Auto-filled by rich_menu.py --public; used by group onboarding chat links.
PUBLIC_BOT_BASIC_ID=
